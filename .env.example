PORT=20150
BASE_URL=http://51.68.34.78:20150
# Public project reference and API URL from the Supabase project URL.
SUPABASE_PROJECT_REF=awcoeccptcjcjmsbuunf
SUPABASE_URL=https://awcoeccptcjcjmsbuunf.supabase.co
# Copy the PostgreSQL URI from Supabase > Connect and paste it here.
DATABASE_URL=
# Or fill these fields from the Session pooler details in Supabase > Connect.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Optional: path to the CA certificate downloaded from Supabase Database Settings.
SUPABASE_DB_CA_CERT=
DB_POOL_SIZE=3
# Optional: set a default device when testing REST endpoints
DEFAULT_DEVICE_ID=web-demo
# Optional companion settings
DEFAULT_CITY=Tuyen Quang
COMPANION_API_URL=http://127.0.0.1:20150
FFMPEG_BIN=ffmpeg
YT_DLP_BIN=yt-dlp
# Optional path to a private Netscape-format YouTube cookies file on the server.
YT_DLP_COOKIES=
# yt-dlp needs a supported JS runtime for YouTube (Node 22+ on the server).
YT_DLP_JS_RUNTIME=node
# Optional override. Leave blank so yt-dlp can use its maintained defaults.
YT_DLP_PLAYER_CLIENTS=
# Optional external YouTube resolver URL. If blank, server.js starts the bundled
# Python resolver on 127.0.0.1:18080 automatically.
YOUTUBE_PROXY_URL=
YOUTUBE_PROXY_TIMEOUT_MS=15000
YOUTUBE_BLOCK_COOLDOWN_MS=600000
# Optional outbound HTTP proxy for the bundled resolver.
YTDLP_PROXY=
# Lottery provider: set the endpoint and your key here (copy this file to .env).
XOSO_API_URL=
XOSO_API_KEY=paste_your_api_key_here
XOSO_API_KEY_HEADER=x-api-key
MUSIC_CHANNEL_3_URL=https://str.vov.gov.vn/vovlive/vov3.sdp_aac/playlist.m3u8
MAX_CONCURRENT_STREAMS=1 # Raise only if the host has enough RAM for additional FFmpeg/yt-dlp processes.
AUDIO_MAX_QUEUE=12
AUDIO_QUEUE_TIMEOUT_MS=25000 # Fail stalled queued playback instead of holding tunnel requests open.
AUDIO_FIRST_BYTE_TIMEOUT_MS=10000 # Stop non-YouTube sources that do not begin streaming audio.
YOUTUBE_FIRST_BYTE_TIMEOUT_MS=30000 # Allow time for yt-dlp to solve YouTube's JS challenge.
GOLD_API_URL=https://taichinh.com/api/v1/gold
